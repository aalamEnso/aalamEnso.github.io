source "https://rubygems.org"

# Uses the same versions of Jekyll and plugins that GitHub Pages uses,
# so what you preview locally matches what gets published.
gem "github-pages", group: :jekyll_plugins

gem "jekyll-include-cache", group: :jekyll_plugins

# Needed for `jekyll serve` on Ruby 3 and newer
gem "webrick"

# Windows has no built-in timezone data, and _config.yml sets a timezone.
# Harmless on Mac and Linux, where this line is ignored.
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin, :jruby]
